#!/bin/bash -l
#
# TEMPLATE — copy to `submit_<name>` and fill in. Do not submit this file.
#
# CPU jobs run on --partition=ral. There is NO `cpu` partition on RAL, and bulk CPU arrays
# never go on `gpu` (nor `ral,gpu`): they starve the A100s. Check `sinfo` before
# inventing a partition name.
#
# Name the copy for what it runs, e.g. submit_<benchmark>_<search>.
#
# Copied from autolens_inference/hpc/batch_cpu/template. The wall-clock basis gate
# (`# WALL-BASIS:` + check_submits.py) arrives with the harness in a later phase; until
# then, size --time by a measured probe, never by a rate measured on another benchmark.

#SBATCH -J <job_name>
#SBATCH --partition=ral
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16gb
#SBATCH --time=24:00:00
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export AP_ROOT=/mnt/ral/jnightin/autofit_profiling
source $AP_ROOT/activate.sh

export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=True

# NPROC throttles JAX's CPU thread pool. Unset, this job takes the whole node.
export NPROC=$SLURM_CPUS_PER_TASK

echo "=========================================="
date

cd $AP_ROOT

# Replace with the real invocation:
#
# python3 scripts/<task>/<leaf>.py --seed $SLURM_ARRAY_TASK_ID

echo "Finished."
date
